# Composer-managed directories (restored by composer install)
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Drupal sensitive files — commit settings.php (has config_sync_directory), not settings.local.php
/web/sites/default/settings.local.php
/web/sites/default/files/
!/web/sites/default/files/.gitkeep

# Drupal scaffold files (regenerated by composer install)
/web/sites/default/default.settings.php
/web/sites/default/default.services.yml

# Environment-specific
/.env
/.env.local

# DDEV runtime (config.yaml is committed)
/.ddev/.gitignore
/.ddev/db_snapshots/
/.ddev/homeadditions/
/.ddev/.traefik/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo

# Drush
/drush/sites/

# Pagefind intermediate HTML export (regenerated by drush scolta:build)
/pagefind-site/

# Allow the database dump and import scripts
!/db/dump.sql.gz
!/import/
/.editorconfig
/.gitattributes
web/sites/default/private/
